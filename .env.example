# Copy this file to ".env" ON THE SERVER and fill in the empty values.
# .env is in .gitignore, so the password never ends up on GitHub
# (this repository is public). Never commit .env.
#
# Put the password in single quotes, so characters like ^ # or spaces are
# read exactly as typed:  DB_PASSWORD='...'

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=''

# Address and port the server listens on.
LISTEN_HOST=0.0.0.0
LISTEN_PORT=25630
